  <!-- People, pre-filtered through the one search view partner_views.xml already defines — the same
       lens the Contacts menu opens, defaulted to one slice per menu entry. -->
  <record id="action_reax_partners_tenants" model="ir.actions.act_window">
    <field name="name">Tenants</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="search_view_id" ref="view_reax_partner_search"/>
    <field name="domain">[('comment', 'ilike', 'Synced from RealEstateApp (')]</field>
    <field name="context">{'search_default_reax_tenants': 1}</field>
  </record>
