<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- List views only, deliberately: Odoo auto-generates a usable form for a model without one, and
       these are sync-overwritten mirrors — the list IS the product. Search views where a module's
       daily question needs one. -->

  <record id="view_reax_lead_list" model="ir.ui.view">
    <field name="name">reax.lead.list</field>
    <field name="model">reax.lead</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="mobile"/>
        <field name="property_id"/>
        <field name="stage_id"/>
        <field name="status_id"/>
        <field name="priority_id"/>
        <field name="assigned_to"/>
        <field name="lead_date"/>
      </list>
    </field>
  </record>
  <record id="view_reax_lead_search" model="ir.ui.view">
    <field name="name">reax.lead.search</field>
    <field name="model">reax.lead</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/><field name="code"/><field name="mobile"/><field name="property_id"/>
        <group expand="0" string="Group By">
          <filter name="by_stage" string="Stage" context="{'group_by':'stage_id'}"/>
          <filter name="by_status" string="Status" context="{'group_by':'status_id'}"/>
          <filter name="by_owner" string="Owner" context="{'group_by':'assigned_to'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_reax_leads" model="ir.actions.act_window">
    <field name="name">Leads</field>
    <field name="res_model">reax.lead</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_reax_lead_search"/>
  </record>

  <record id="view_reax_request_list" model="ir.ui.view">
    <field name="name">reax.leasing.request.list</field>
    <field name="model">reax.leasing.request</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="partner_id"/>
        <field name="property_id"/>
        <field name="purpose"/>
        <field name="lease_start"/>
        <field name="requested_rent"/>
        <field name="status_id"/>
      </list>
    </field>
  </record>
  <record id="action_reax_requests" model="ir.actions.act_window">
    <field name="name">Leasing Requests</field>
    <field name="res_model">reax.leasing.request</field>
    <field name="view_mode">list,form</field>
  </record>

