    <field name="arch" type="xml">
      <search>
        <field name="code"/><field name="property_id"/><field name="assigned_to"/>
        <group expand="0" string="Group By">
          <filter name="by_status" string="Status" context="{'group_by':'status_id'}"/>
          <filter name="by_property" string="Property" context="{'group_by':'property_id'}"/>
          <filter name="by_priority" string="Priority" context="{'group_by':'priority'}"/>
        </group>
      </search>
    </field>
  </record>
