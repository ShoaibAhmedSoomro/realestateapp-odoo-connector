<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    A block in Odoo's own Settings, not a separate app.

    Deliberate: somebody setting up an integration goes to Settings, and a one-field form does not deserve
    a menu entry of its own. It also means the module adds no menus, no models and no tables — it is a
    settings panel and a button, which is the smallest thing that can do this job.
  -->
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.realestateapp</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="RealEstateApp" name="realestateapp_connector"
             data-string="RealEstateApp"
             logo="/realestateapp_connector/static/description/icon.png">

          <!-- The wordmark. Two images rather than one: the black logo vanishes on Odoo's dark backend,
               so settings.dark.scss swaps which one is displayed. No 'class' or 'style' may go on <app>
               itself — it is an OWL component with declared props, and an undeclared one throws in debug
               mode and takes the entire Settings page down with it. -->
          <div class="reax-wordmark">
            <img src="/realestateapp_connector/static/src/img/REA-logo-black.svg"
                 alt="RealEstateApp" class="reax-logo-light"/>
            <img src="/realestateapp_connector/static/src/img/REA-logo-white.svg"
                 alt="RealEstateApp" class="reax-logo-dark"/>
            <span class="reax-wordmark-sub">Property management for the UAE</span>
          </div>

          <block title="Connection" name="reax_connection">
            <setting string="Status" help="Whether this Odoo is connected to RealEstateApp.">
              <div class="content-group mt-2">
                <div invisible="not reax_connected_at">
                  <span class="badge text-bg-success">Connected</span>
                  <span class="text-muted ms-2">
                    as <field name="reax_account" readonly="1" class="oe_inline"/>
                    since <field name="reax_connected_at" readonly="1" class="oe_inline"/>
                  </span>
                </div>
                <div invisible="reax_connected_at">
                  <span class="badge text-bg-secondary">Not connected</span>
                  <p class="text-muted mt-2 mb-0">
                    Open <b>Connectors</b> in RealEstateApp, choose Odoo, and press
                    <b>Connect with the Odoo app</b> to get a pairing code.
                  </p>
                </div>
              </div>
            </setting>

            <setting string="Pairing code"
                     help="From Connectors in RealEstateApp. Valid for 30 minutes, and can be used once.">
              <field name="reax_pairing_code" placeholder="Paste the code here"/>
              <div class="mt-2">
                <button name="action_reax_connect" type="object" string="Connect" class="btn-primary"
                        invisible="reax_connected_at"/>
                <button name="action_reax_connect" type="object" string="Reconnect" class="btn-secondary"
                        invisible="not reax_connected_at"/>
                <button name="action_reax_disconnect" type="object" string="Disconnect" class="btn-link text-danger"
                        invisible="not reax_connected_at"
                        confirm="This revokes the API key this app created. RealEstateApp will stop reading this Odoo immediately. Continue?"/>
              </div>
            </setting>

            <setting string="RealEstateApp address"
                     help="Only change this if you were given a different address for RealEstateApp.">
              <field name="reax_endpoint" placeholder="https://www.dubailuxuryhomes.ae"/>
            </setting>
          </block>

          <!-- Worked out from this database, not written down here.
               The old version was a hand-typed list of two items that claimed "it never writes back" —
               untrue the moment the app started sending tenants and landlords, and a screen that lies
               about what leaves your system is worse than one that says nothing. The computed field can
               only ever name datasets the code will genuinely move. -->
          <block title="What gets shared" name="reax_shares_block">
            <setting class="reax-wide"
                     help="Worked out from the apps you actually have installed, and from what your Odoo login is allowed to do.">
              <field name="reax_shares" nolabel="1" readonly="1" class="reax-shares"/>
              <p class="text-muted mt-2 mb-0">
                Your password is never used or sent. This app creates its own API key, which you can see and
                revoke at any time under <b>My Profile → Account Security</b>.
              </p>
            </setting>
          </block>

          <!-- Who to go to when it misbehaves. A connector that reaches into two systems should say who
               built it, on the screen, rather than only in a manifest nobody opens. -->
          <block title="About" name="reax_about">
            <setting help="Who built this app, and where to report a problem with it.">
              <div class="text-muted">
                <div>Developed by <b>Shoaib Ahmed</b> — Developer (ASICO)</div>
                <div class="mt-1">RealEstateApp Connector for Odoo 18 · ASICO Property Management</div>
              </div>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
