<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    A top-level entry in Odoo's app grid.

    The module started as a settings block with no menu, which is the ordinary Odoo idiom for a connector —
    but it made the app invisible: somebody who installed it had no way to find it except by knowing to look
    under Settings. An integration people are told to install should be somewhere they can see.

    It then had exactly ONE menu, Connection, which was the opposite problem: the app you connect through
    showed you the connection and nothing it had done. Everything the connector sends lands in Odoo's own
    tables, so the data menus below are filtered lenses over those — real res.partner contacts and real
    account.move invoices, not copies. Connection moves under Configuration, where Odoo puts settings.

    The action deliberately opens Odoo's OWN settings screen scrolled to this module's block, rather than a
    second screen of our own. `target: inline` plus `context: {'module': ...}` is exactly how Odoo's built-in
    settings shortcuts work, so the connection is configured in one place whichever route you arrive by.
  -->
  <record id="action_reax_settings" model="ir.actions.act_window">
    <field name="name">RealEstateApp</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">inline</field>
    <field name="context">{'module': 'realestateapp_connector'}</field>
  </record>

  <!-- web_icon points at the same icon.png the Apps Store listing uses, so the grid tile and the store
       tile are the one image rather than two that drift apart. -->
  <menuitem id="menu_reax_root"
            name="RealEstateApp"
            web_icon="realestateapp_connector,static/description/icon.png"
            sequence="95"/>

  <!-- Data first: this is what somebody opens the app to look at. -->
  <menuitem id="menu_reax_contacts"
            name="Contacts"
            parent="menu_reax_root"
            action="action_reax_partners"
            sequence="10"/>

  <!-- The estate itself — the app's Properties, Units and Contracts modules, mirrored as first-class
       records the sync overwrites. A contract links to the SAME res.partner its rent invoices are
       raised against, so the chain app → contract → tenant → invoice is walkable inside Odoo. -->
  <menuitem id="menu_reax_properties" name="Properties" parent="menu_reax_root"
            action="action_reax_properties" sequence="20"/>
  <menuitem id="menu_reax_units" name="Units" parent="menu_reax_root"
            action="action_reax_units" sequence="30"/>
  <menuitem id="menu_reax_contracts" name="Contracts" parent="menu_reax_root"
            action="action_reax_contracts" sequence="40"/>

  <!-- Rent invoices are NOT here. They live in account.move, and account is not a dependency of this
       module — a CRM-only Odoo can still use the contact sync, and requiring accounting to install a
       connector would be wrong. The bridge module realestateapp_connector_account adds that menu and
       installs itself automatically wherever both this and Accounting are present. -->

  <menuitem id="menu_reax_config"
            name="Configuration"
            parent="menu_reax_root"
            sequence="90"
            groups="base.group_system"/>

  <menuitem id="menu_reax_connection"
            name="Connection"
            parent="menu_reax_config"
            action="action_reax_settings"
            sequence="10"
            groups="base.group_system"/>
</odoo>
