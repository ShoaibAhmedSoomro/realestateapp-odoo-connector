<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    THE PAYMENT SCHEDULE, ON THE CONTRACT.

    Every charge RealEstateApp raised for this tenancy, in one list: rent instalment by instalment,
    and alongside them the security deposit, administration fee, commission and anything else the
    contract carries. They are the SAME account.move records Odoo posts and reconciles — nothing here
    is a copy, and opening a line opens the real invoice.

    Each instalment is its own invoice on purpose: they fall due on different dates, book to
    different accounts (rent to 40137, a deposit to the 2050 liability, commission to 40111) and are
    settled by different cheques. That is correct accounting and it is why one invoice shows one
    line. What was missing was any way to see the SET, which is what this is.
  -->
  <record id="view_reax_contract_form_schedule" model="ir.ui.view">
    <field name="name">Tenancy Contract — Payment Schedule</field>
    <field name="model">reax.contract</field>
    <field name="inherit_id" ref="realestateapp_connector.view_reax_contract_form"/>
    <field name="arch" type="xml">

      <!-- A count on the button that was already there, so the schedule announces itself instead of
           looking like an empty link. -->
      <xpath expr="//button[@name='action_view_invoices']" position="attributes">
        <attribute name="string"/>
      </xpath>
      <xpath expr="//button[@name='action_view_invoices']" position="inside">
        <field name="invoice_count" widget="statinfo" string="Charges"/>
      </xpath>

      <!-- The money summary belongs next to the rent, where somebody is already looking.
           Anchored on a FIELD, not on a group's label: Odoo 17+ refuses `string` as an inheritance
           selector ("View inheritance may not use attribute 'string' as a selector"), and a label is
           the wrong thing to depend on anyway — it is translated, and somebody may reword it. -->
      <xpath expr="//field[@name='vat_on_rent']" position="after">
        <field name="company_currency_id" invisible="1"/>
        <field name="invoice_total" widget="monetary"/>
        <field name="invoice_paid" widget="monetary"/>
        <field name="invoice_due" widget="monetary"/>
      </xpath>

      <xpath expr="//sheet" position="inside">
        <notebook>
          <page string="Payment Schedule" name="reax_schedule">
            <field name="invoice_ids" nolabel="1" readonly="1">
              <list decoration-success="payment_state in ('paid','in_payment')"
                    decoration-muted="state == 'cancel'"
                    decoration-danger="state == 'posted' and payment_state == 'not_paid' and invoice_date_due &lt; current_date">
                <field name="invoice_date_due" string="Due"/>
                <field name="ref" string="Reference"/>
                <field name="name" string="Invoice"/>
                <field name="amount_total" string="Amount" sum="Scheduled"/>
                <field name="amount_residual" string="Outstanding" sum="Outstanding"/>
                <field name="state" string="Entry"/>
                <field name="payment_state" string="Payment" widget="badge"
                       decoration-success="payment_state in ('paid','in_payment')"
                       decoration-warning="payment_state == 'partial'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoice_date" column_invisible="1"/>
              </list>
            </field>
            <p class="text-muted mt-2">
              Each row is one charge on its own Odoo invoice — rent falls due monthly or quarterly,
              while a deposit, administration fee or commission is normally a single charge at the
              start. Open a row to see its lines, journal entries and cheques.
            </p>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>

  <!-- Group the rent-invoice list by contract, which the text ref could never do. -->
  <record id="view_reax_move_search_contract" model="ir.ui.view">
    <field name="name">account.move.search.realestateapp.contract</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="realestateapp_connector_account.view_reax_move_search"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='reax_group_partner']" position="before">
        <field name="reax_contract_id"/>
        <filter name="reax_group_contract" string="Contract"
                context="{'group_by': 'reax_contract_id'}"/>
      </xpath>
    </field>
  </record>

  <!-- And show it on the invoice itself, so the link is visible from both ends. -->
  <record id="view_reax_move_form_contract" model="ir.ui.view">
    <field name="name">account.move.form.realestateapp.contract</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ref']" position="after">
        <field name="reax_contract_id" invisible="not reax_contract_id" readonly="1"/>
      </xpath>

      <!-- The rest of the contract's charges, on the invoice, because that is where people are
           already standing when they ask "where are the others?". They are NOT lines of this
           invoice and must never be: an invoice's lines have to sum to its own total, so a rent
           invoice carrying the deposit and commission as lines would claim the contract's whole
           value and post that into the books. They are sibling invoices, shown as such. -->
      <xpath expr="//notebook" position="inside">
        <page string="Contract Schedule" name="reax_contract_schedule"
              invisible="not reax_contract_id">
          <group>
            <group>
              <field name="company_currency_id" invisible="1"/>
              <field name="reax_schedule_total"/>
              <field name="reax_schedule_paid"/>
            </group>
            <group>
              <field name="reax_schedule_due"/>
            </group>
          </group>
          <field name="reax_schedule_ids" nolabel="1" readonly="1">
            <list decoration-success="payment_state in ('paid','in_payment')"
                  decoration-muted="state == 'cancel'"
                  decoration-danger="state == 'posted' and payment_state == 'not_paid' and invoice_date_due &lt; current_date">
              <field name="invoice_date_due" string="Due"/>
              <field name="ref" string="Charge"/>
              <field name="name" string="Invoice"/>
              <field name="amount_total" string="Amount" sum="Scheduled"/>
              <field name="amount_residual" string="Outstanding" sum="Outstanding"/>
              <field name="payment_state" string="Payment" widget="badge"
                     decoration-success="payment_state in ('paid','in_payment')"
                     decoration-warning="payment_state == 'partial'"/>
              <field name="currency_id" column_invisible="1"/>
              <field name="state" column_invisible="1"/>
            </list>
          </field>
          <p class="text-muted mt-2">
            Every charge on this tenancy, each on its own invoice — this one included. Rent falls due
            monthly or quarterly; a deposit, administration fee or commission is normally a single
            charge at the start. Open a row to go to that invoice and its cheque.
          </p>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
